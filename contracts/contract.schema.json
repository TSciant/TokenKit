{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tokenkit:schema:contract",
  "title": "token-kit component contract",
  "description": "What one component promises. Facts (component to checks) are generated by tools/contracts.mjs from the code, figma/props.json and the CSS, and rewritten on every run. Decisions (decisions, a11y, i18n, events, privacy) are written by people, kept by every run, and null until someone fills them in. See docs/11-tokens-and-contracts.md.",
  "type": "object",
  "required": [
    "component",
    "layer",
    "sources",
    "css",
    "dataTk",
    "figma",
    "props",
    "tokens",
    "checks",
    "decisions",
    "a11y",
    "i18n",
    "events",
    "privacy"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "component": {
      "type": "string",
      "description": "The exported component's name."
    },
    "layer": {
      "enum": [
        "primitive",
        "pattern",
        "shell",
        "pack"
      ]
    },
    "about": {
      "type": [
        "string",
        "null"
      ],
      "description": "The component's own doc comment."
    },
    "sources": {
      "type": "object",
      "description": "One slot per platform. null until a kit exists for it.",
      "required": [
        "react",
        "swiftui",
        "compose"
      ],
      "properties": {
        "react": {
          "type": [
            "string",
            "null"
          ]
        },
        "swiftui": {
          "type": [
            "string",
            "null"
          ]
        },
        "compose": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "css": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Stylesheets with rules for its data-tk elements."
    },
    "dataTk": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "The data-tk names its elements carry."
    },
    "figma": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "node",
          "codeConnect",
          "map",
          "unpaired"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "node": {
            "type": "string",
            "pattern": "^\\d+:\\d+$"
          },
          "codeConnect": {
            "type": "boolean"
          },
          "map": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "description": "Figma property to its code form."
          },
          "unpaired": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Figma properties no prop takes: content or layout, or a decision still to record."
          }
        },
        "additionalProperties": false
      }
    },
    "props": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": [
          "type"
        ],
        "properties": {
          "type": {
            "enum": [
              "enum",
              "boolean",
              "text",
              "number",
              "content",
              "icon or content",
              "event",
              "other"
            ]
          },
          "values": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "default": {
            "type": "string"
          },
          "required": {
            "const": true
          },
          "figma": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "about": {
            "type": "string"
          },
          "ts": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "tk slots its CSS reads, without --tk-."
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decisions": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "omit": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "A Figma property no prop takes, as \"<Figma component>.<property>\", with the reason: runtime state, layout, content, or Figma only."
        },
        "pairWith": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "A Figma property, as \"<Figma component>.<property>\", to the code form it becomes where the names or shapes differ (badge, stats[0].value, children)."
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "a11y": {
      "type": [
        "object",
        "null"
      ],
      "description": "role, name, keys (key to effect), focus behaviour."
    },
    "i18n": {
      "type": [
        "object",
        "null"
      ],
      "description": "strings, expansion, rtl, logicalCss."
    },
    "events": {
      "type": [
        "object",
        "null"
      ],
      "description": "event name to { when, props }: what it may report (tk:event)."
    },
    "privacy": {
      "type": [
        "object",
        "null"
      ],
      "description": "never (what it must not report) and consent."
    }
  },
  "additionalProperties": false
}

    "Masthead.Nav 1",
    "Masthead.Nav 2",
    "Masthead.Nav 3",
    "Masthead.Nav 4",
    "Masthead.Nav 5",
    "Masthead.Nav 6"
   ]
  },
  "navLabel": {
   "type": "text",
   "default": "\"Primary\"",
   "about": "Aria label for the primary nav."
  },
  "withMegaMenu": {
   "type": "boolean",
   "default": "false",
   "about": "Swaps the inline nav for the mega menu, wide and compact alike."
  },
  "megaMenu": {
   "type": "other",
   "ts": "MegaMenu",
   "default": "MEGA",
   "figma": [
    "Masthead.Mega menu"
   ]
  },
  "megaTrigger": {
   "type": "text",
   "default": "MEGA_TRIGGER",
   "about": "The nav item that owns the panel; every other item is a plain link."
  },
  "megaActions": {
   "type": "other",
   "ts": "string[]",
   "default": "MEGA_ACTIONS"
  },
  "megaColumns": {
   "type": "enum",
   "values": [
    "2",
    "3",
    "4",
    "1"
   ],
   "default": "3"
  },
  "megaInitialOpen": {
   "type": "boolean",
   "default": "false",
   "about": "The mega panel open on first render (wide header only)."
  },
  "showSearch": {
   "type": "boolean",
   "default": "true",
   "figma": [
    "Masthead.Search"
   ]
  },
  "searchLabel": {
   "type": "text",
   "about": "The search field's accessible name. Left out, it is “Search” and the brand, so a site named in `brand` is the site searched."
  },
  "showContactCta": {
   "type": "boolean",
   "default": "true",
   "figma": [
    "Masthead.Contact CTA"
   ]
  },
  "contactLabel": {
   "type": "text",
   "default": "CONTACT_CTA_LABEL",
   "about": "The contact button's label (“Contact us”, “Book a call”)."
  }

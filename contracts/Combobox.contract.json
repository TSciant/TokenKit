  },
  "onInputChange": {
   "type": "event"
  },
  "allowCustom": {
   "type": "boolean",
   "default": "false",
   "about": "Free text is a value too (a search), rather than only the options."
  },
  "kind": {
   "type": "enum",
   "values": [
    "search",
    "select"
   ],
   "default": "\"select\"",
   "about": "select: a chevron at the end. search: a magnifier at the start, no chevron."
  },
  "openOnFocus": {
   "type": "boolean",
   "default": "false",
   "about": "Open on focus, for a short list of recent items. Off by default: a list on every Tab is noise."
  },
  "filter": {
   "type": "other",
   "ts": "(option: ComboboxOption, text: string) => boolean",
   "default": "contains",
   "about": "Which options the text finds. Case-insensitive \"contains\" on the label and keywords by default."
  },
  "emptyText": {
   "type": "text",
   "default": "\"No matches\""
  },
  "loading": {
   "type": "boolean",
   "default": "false",
   "about": "The options are on their way (a fetch)."
  }
 },

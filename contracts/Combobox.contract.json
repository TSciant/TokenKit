  },
  "value": {
   "type": "text",
   "figma": [
    "Combobox.Value"
   ],
   "about": "The chosen option's value. Changes only on Enter or a click, never on the arrow keys."
  },
  "defaultValue": {
   "type": "text",
   "default": "null"
  },
  "onChange": {
   "type": "event"
  },

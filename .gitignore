node_modules/
dist/
storybook-static/
.DS_Store
*.log

# audit artifacts — large, regenerable
audits/*/captures/
audits/*/onionskin/
!audits/*/audit.md
!audits/*/inventory.json

# the Next.js app (npm run next:build)
next/.next/
next/next-env.d.ts
# generated by tools/sync-next-public.mjs from src/client/stock and node_modules
next/public/
next/tsconfig.tsbuildinfo
next/yarn.lock

# Scratch tooling. Prefixed _ by convention; never meant to be committed,
# and one that was took the boundary gate down with ENOENT after deletion.
tools/_*

# Client names for the neutral gate — checked locally, never committed.
tools/neutral-terms.local.json

# Videos are build outputs: record, send, publish, never commit.
# tools/media-gate.mjs fails the check if one is tracked anyway.
*.webm
*.mp4
*.m4v
*.mov
*.mkv
*.avi
*.ogv

# The film's bed: a source the recorder reads, kept with the film, not in git.
tools/timeline/bed.mp3
tools/timeline/.picture.webm
tools/timeline/.sound.webm
tools/timeline/web/

# The evening run's reports, state and logs (tools/evening.mjs).
.evening/

# The planner spike's generated pairs: rebuilt by node tools/planner/build-dataset.mjs
tools/planner/data/train.jsonl
tools/planner/data/test.jsonl
tools/planner/data/heldout.jsonl
tools/planner/data/blind.jsonl
tools/planner/data/blind2.jsonl
tools/planner/data/implied-v4-raw.json
# The planner spike's Python environment (laya), kept at a short path for Windows
.lv/
tools/planner/data/laya-*.jsonl
tools/planner/data/ollama-*.jsonl
tools/planner/data/calibration.jsonl

# Python bytecode from the planner scripts
__pycache__/
